#!/usr/bin/env bash
# Open the likes viewer (out/index.html) in the default browser. Works offline from the local data
# (images still come from X's CDN unless you ran `./xlikes media`). Re-exports first when the data
# is newer than the viewer, so it always shows everything collected so far.
#   ./xlikes-view                   open it
#   ./xlikes-view --demo            open it on the made-up demo data in demo/ (no login needed)
#   ./xlikes-view --install-desktop add "X Likes" to the app menu (~/.local/share/applications)
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ "${1:-}" == "--install-desktop" ]]; then
  d="${XDG_DATA_HOME:-$HOME/.local/share}/applications/x-likes.desktop"
  mkdir -p "$(dirname "$d")"
  sed "s|@DIR@|$here|g" "$here/x-likes.desktop.in" > "$d"
  update-desktop-database "$(dirname "$d")" 2>/dev/null || true
  echo "Installed $d (search the app menu for \"X Likes\")."
  exit 0
fi
base="$here"
if [[ "${1:-}" == "--demo" ]]; then base="$here/demo"; export XLIKES_DATA_HOME="$base"; fi
data="$base/data/likes.jsonl" view="$base/out/index.html"
if [[ ! -f "$data" ]]; then
  notify-send "X Likes" "No likes collected yet: run ./xlikes scrape first, or ./xlikes-view --demo (see README)." 2>/dev/null || true
  echo "No likes collected yet: run ./xlikes scrape first, or ./xlikes-view --demo (see README)." >&2
  exit 1
fi
if [[ ! -f "$view" || ! -f "$base/out/likes.js" || "$data" -nt "$base/out/likes.js" || "$here/viewer.html" -nt "$view" || -f "$base/data/categories.jsonl" && "$base/data/categories.jsonl" -nt "$base/out/likes.js" ]]; then
  python3 "$here/x_likes.py" export >/dev/null  # stdlib only: no venv needed to view
fi
exec xdg-open "$view"
